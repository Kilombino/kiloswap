# Copy to .env (600) and adjust. No secrets here: setup.sh writes them under
# ${KILOSWAP_ROOT}/secrets.
KILOSWAP_ROOT=/srv/kiloswap-data
# The docker network of the stack (the node's rpcallowip must include it)
KILOSWAP_SUBNET=172.30.91.0/24
# The host address the containers reach the node at (its rpcbind / zmqpub)
NODE_HOST=<host LAN address (the node rpcbind)>
NODE_RPC_PORT=8332
# The operator's lnd: its container name on its docker network, and its data
# directory on the host (tls.cert; the macaroons are baked into it)
LND_HOST=lnd-blake2b
LND_NETWORK=lnd-net
LND_DIR=/srv/lnd
# The LSP's state file (the guard keeps its open requests' coins aside)
LSP_STATE=/home/<user>/.config/kilo-lsp/state.json
# Our mempool's docker network (the explorer API at /explorer/api)
EXPLORER_NETWORK=mempool-deploy_default
WEB_PORT=3260
ONION_PORT=3261
# The guard POSTs every refusal here (kiloswap-watch on the host gateway)
ALERT_URL=http://172.30.91.1:9599/
# Limits (sat)
# launch limits (0.1 BTC per operation, 0.25 BTC a day); later 100000000 /
# 200000000, together with the backend's maxSwapAmount
MAX_PER_OP_SAT=10000000
DAILY_SAT=25000000
RESERVE_SAT=50000000
MAX_PENDING_REVERSE=5
MAX_UNRESOLVED=2
# reverse swaps from 10000 sat (the backend's minSwapAmount); 2 lockups a block
MIN_REVERSE_SAT=10000
MAX_LOCKUPS_PER_BLOCK=2
# routing fee of a submarine payment: min(FEE_RATIO of the invoice, max(the
# lockup's surplus over invoice+claim, 10 sat)); the guard rewrites the limit
ROUTING_CAP=1
ROUTING_FLOOR_SAT=10
MIN_FEE_SAT=10
FEE_RATIO=0.0001
REQUIRED_CONFS=3
# Filled in by setup.sh from ${KILOSWAP_ROOT}/secrets (compose needs it as a variable)
NODE_RPC_PASSWORD=
