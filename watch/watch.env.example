# ~/.config/kiloswap-watch/watch.env (600)
TELEGRAM_TOKEN_FILE=/home/<user>/.config/kiloswap-watch/telegram-token
TELEGRAM_CHAT=
PSQL=docker exec -i kiloswap-postgres-1 psql -U kiloswap_watch -d boltz -At -F |
LNCLI=docker exec <lnd container> lncli --network=mainnet --macaroonpath /root/.lnd/data/chain/bitcoin/mainnet/readonly.macaroon
RESERVE_SAT=50000000
LOW_AVAIL_SAT=10000000
MAX_PENDING_REVERSE=5
LOW_LN_OUT_SAT=5000000
LOW_LN_IN_SAT=5000000
ALERT_PORT=9599
ALERT_HOST=172.30.91.1
BACKUP_CMD=sudo -n /opt/kiloswap/deploy/backup/kiloswap-backup.sh change
INTERVAL_S=20
